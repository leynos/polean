{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polean tenant-write v0 policy IR",
  "type": "object",
  "properties": {
    "profile": {
      "const": "polean.tenant-write.v0"
    },
    "rules": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "enum": [
            "same_tenant",
            "write_action",
            "admin_role",
            "owns_resource",
            "locked",
            "unlocked"
          ]
        }
      }
    }
  },
  "required": [
    "profile",
    "rules"
  ],
  "additionalProperties": false
}
